/**
 * @file test_vad.c
 * @brief Unit tests validating Voice Activity Detection energy calculation and frame processing.
 */

#include "dsp_core.h"
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <assert.h>
#include <string.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

int main(void) {
    printf("[TEST] Running SIMD VAD verification suite...\n");

    dsp_init();

    AudioFramePacket packet;
    memset(&packet, 0, sizeof(packet));
    packet.sample_rate = 16000;
    packet.channels = 1;
    packet.sample_count = FRAME_SAMPLES;

    /* 1. Test Silent Frame */
    for (int i = 0; i < FRAME_SAMPLES; i++) {
        packet.pcm_data[i] = 0.0f;
    }
    dsp_process_frame(&packet);
    printf("  -> Silent Frame: VAD Active = %d, Confidence = %.4f\n", packet.vad_active, (double)packet.vad_confidence);
    assert(packet.vad_active == 0 && "Silent frame falsely flagged as active speech!");
    assert(packet.vad_confidence < 0.05f && "Silent frame confidence should be near zero!");
    assert((packet.flags & FLAG_DSP_DONE) && "FLAG_DSP_DONE not set!");

    /* 2. Test Loud Voice Frame (1 kHz tone, amplitude 0.4) */
    for (int i = 0; i < FRAME_SAMPLES; i++) {
        packet.pcm_data[i] = 0.4f * sinf(2.0f * (float)M_PI * 1000.0f * (float)i / 16000.0f);
    }
    dsp_process_frame(&packet);
    printf("  -> Active Speech Frame: VAD Active = %d, Confidence = %.4f\n", packet.vad_active, (double)packet.vad_confidence);
    assert(packet.vad_active == 1 && "Speech frame not detected by VAD!");
    assert(packet.vad_confidence > 0.8f && "Active frame confidence should be high!");

    /* 3. Test Low Noise Frame below threshold */
    for (int i = 0; i < FRAME_SAMPLES; i++) {
        packet.pcm_data[i] = 0.002f * ((float)rand() / (float)RAND_MAX - 0.5f);
    }
    dsp_process_frame(&packet);
    printf("  -> Low Noise Frame: VAD Active = %d, Confidence = %.4f\n", packet.vad_active, (double)packet.vad_confidence);
    assert(packet.vad_active == 0 && "Low noise floor triggered false positive VAD!");

    dsp_destroy();
    printf("[PASS] VAD verification test passed successfully!\n");
    return 0;
}
</file>

