/**
 * @file simd_fft_neon.c
 * @brief ARM NEON vector fallback for ARM64/Apple Silicon architectures.
 */

#include "simd_fft.h"

#if defined(__ARM_NEON) || defined(__aarch64__)
#include <arm_neon.h>
#include <math.h>

void dsp_fft_magnitude_neon(const float* real, const float* imag, float* magnitude, size_t n) {
    size_t i = 0;
    size_t vec_len = n - (n % 4);
    const float norm_factor = 2.0f / 512.0f;
    float32x4_t v_norm = vdupq_n_f32(norm_factor);

    for (; i < vec_len; i += 4) {
        float32x4_t r = vld1q_f32(&real[i]);
        float32x4_t im = vld1q_f32(&imag[i]);

        float32x4_t r2 = vmulq_f32(r, r);
        float32x4_t im2 = vmulq_f32(im, im);
        float32x4_t sum2 = vaddq_f32(r2, im2);

        float32x4_t mag = vsqrtq_f32(sum2);
        float32x4_t scaled = vmulq_f32(mag, v_norm);

        vst1q_f32(&magnitude[i], scaled);
    }

    for (; i < n; i++) {
        float r = real[i];
        float im = imag[i];
        magnitude[i] = sqrtf(r * r + im * im) * norm_factor;
    }
}
#endif
