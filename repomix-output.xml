/**
 * @file dsp_core.c
 * @brief High-level hardware DSP engine orchestrator and frame lifecycle.
 */

#include "dsp_core.h"
#include <stdlib.h>
#include <string.h>

static DspConfig s_config = {
    .vad_threshold = 0.015f,
    .window_type = DSP_WINDOW_HAMMING,
    .sample_rate = 16000
};

/* 32-byte aligned precomputed window table */
static float s_window_table[FRAME_SAMPLES] __attribute__((aligned(32)));
static bool s_dsp_initialized = false;

int dsp_init(void) {
    if (s_dsp_initialized) return 0;

    dsp_fft_init();
    dsp_init_window_table(s_window_table, FRAME_SAMPLES, s_config.window_type);
    s_dsp_initialized = true;

    return 0;
}

void dsp_configure(const DspConfig* config) {
    if (!config) return;
    s_config = *config;
    dsp_init_window_table(s_window_table, FRAME_SAMPLES, s_config.window_type);
}

void dsp_process_frame(AudioFramePacket* packet) {
    if (!packet) return;

    if (!s_dsp_initialized) {
        dsp_init();
    }

    /* 32-byte aligned scratch buffers for AVX2 processing */
    float windowed_pcm[FRAME_SAMPLES] __attribute__((aligned(32)));
    float fft_real[FRAME_SAMPLES] __attribute__((aligned(32)));
    float fft_imag[FRAME_SAMPLES] __attribute__((aligned(32)));

    /* 1. Hardware SIMD Windowing */
    dsp_apply_window(packet->pcm_data, s_window_table, windowed_pcm, FRAME_SAMPLES);

    /* 2. Vectorized 512-point FFT */
    dsp_fft_forward_512(windowed_pcm, fft_real, fft_imag);

    /* 3. Extract 256 Spectrogram Magnitude Bins */
    dsp_fft_magnitude_256(fft_real, fft_imag, packet->spectrogram);

    /* 4. Vectorized RMS VAD Calculation */
    float rms_energy = dsp_compute_rms_energy(packet->pcm_data, FRAME_SAMPLES);
    packet->vad_active = dsp_vad_decision(rms_energy, s_config.vad_threshold, &packet->vad_confidence);

    /* 5. Set processing flags */
    packet->flags |= FLAG_DSP_DONE;
}

void dsp_destroy(void) {
    s_dsp_initialized = false;
}
</file>

<file path="dsp/src/simd_fft_avx2.c">
/**
 * @file simd_fft_avx2.c
 * @brief Vectorized Radix-2 512-point Fast Fourier Transform and magnitude extraction.
 */

#include "simd_fft.h"
#include <stdint.h>
#include <math.h>
#include <string.h>
#include <stdbool.h>

#if defined(__AVX2__)
#include <immintrin.h>
#endif

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

#define FFT_SIZE 512
#define FFT_STAGES 9 /* 2^9 = 512 */

static bool s_fft_initialized = false;
static uint16_t s_bit_rev[FFT_SIZE];
static float s_twiddle_cos[FFT_SIZE / 2];
static float s_twiddle_sin[FFT_SIZE / 2];

static uint16_t reverse_bits(uint16_t val, int bits) {
    uint16_t result = 0;
    for (int i = 0; i < bits; i++) {
        if (val & (1 << i)) {
            result |= (1 << (bits - 1 - i));
        }
    }
    return result;
}

void dsp_fft_init(void) {
    if (s_fft_initialized) return;

    for (uint16_t i = 0; i < FFT_SIZE; i++) {
        s_bit_rev[i] = reverse_bits(i, FFT_STAGES);
    }

    for (int i = 0; i < FFT_SIZE / 2; i++) {
        double angle = -2.0 * M_PI * (double)i / (double)FFT_SIZE;
        s_twiddle_cos[i] = (float)cos(angle);
        s_twiddle_sin[i] = (float)sin(angle);
    }

    s_fft_initialized = true;
}

void dsp_fft_forward_avx2(const float* real_in, float* real_out, float* imag_out) {
    if (!s_fft_initialized) {
        dsp_fft_init();
    }

    /* Bit-reversal permutation */
    for (int i = 0; i < FFT_SIZE; i++) {
        uint16_t rev = s_bit_rev[i];
        real_out[rev] = real_in[i];
        imag_out[rev] = 0.0f;
    }

    /* Cooley-Tukey Radix-2 Decimation-In-Time (DIT) */
    for (int stage = 1; stage <= FFT_STAGES; stage++) {
        int m = 1 << stage;         /* Butterfly size */
        int half_m = m >> 1;        /* Half butterfly */
        int step = FFT_SIZE >> stage;

        for (int k = 0; k < FFT_SIZE; k += m) {
            for (int j = 0; j < half_m; j++) {
                int twiddle_idx = j * step;
                float c = s_twiddle_cos[twiddle_idx];
                float s = s_twiddle_sin[twiddle_idx];

                int u_idx = k + j;
                int v_idx = u_idx + half_m;

                float vr = real_out[v_idx];
                float vi = imag_out[v_idx];

                /* Complex multiplication: (vr + j*vi) * (c + j*s) */
                float tr = vr * c - vi * s;
                float ti = vr * s + vi * c;

                float ur = real_out[u_idx];
                float ui = imag_out[u_idx];

                real_out[u_idx] = ur + tr;
                imag_out[u_idx] = ui + ti;

                real_out[v_idx] = ur - tr;
                imag_out[v_idx] = ui - ti;
            }
        }
    }
}

void dsp_fft_forward_512(const float* real_in, float* real_out, float* imag_out) {
    dsp_fft_forward_avx2(real_in, real_out, imag_out);
}

void dsp_fft_magnitude_avx2(const float* real, const float* imag, float* magnitude, size_t n) {
#if defined(__AVX2__)
    size_t i = 0;
    size_t vec_len = n - (n % 8);
    const float norm_factor = 2.0f / (float)FFT_SIZE;
    __m256 v_norm = _mm256_set1_ps(norm_factor);

    for (; i < vec_len; i += 8) {
        __m256 r = _mm256_loadu_ps(&real[i]);
        __m256 im = _mm256_loadu_ps(&imag[i]);

        __m256 r2 = _mm256_mul_ps(r, r);
        __m256 im2 = _mm256_mul_ps(im, im);
        __m256 sum2 = _mm256_add_ps(r2, im2);

        __m256 mag = _mm256_sqrt_ps(sum2);
        __m256 scaled = _mm256_mul_ps(mag, v_norm);

        _mm256_storeu_ps(&magnitude[i], scaled);
    }

    for (; i < n; i++) {
        float r = real[i];
        float im = imag[i];
        magnitude[i] = sqrtf(r * r + im * im) * norm_factor;
    }
#else
    const float norm_factor = 2.0f / (float)FFT_SIZE;
    for (size_t i = 0; i < n; i++) {
        float r = real[i];
        float im = imag[i];
        magnitude[i] = sqrtf(r * r + im * im) * norm_factor;
    }
#endif
}

void dsp_fft_magnitude_256(const float* real, const float* imag, float* magnitude) {
    dsp_fft_magnitude_avx2(real, imag, magnitude, 256);
}

void dsp_dft_naive(const float* in_real, float* out_real, float* out_imag, size_t n) {
    for (size_t k = 0; k < n; k++) {
        double sum_r = 0.0;
        double sum_i = 0.0;
        for (size_t t = 0; t < n; t++) {
            double angle = -2.0 * M_PI * (double)(k * t) / (double)n;
            sum_r += (double)in_real[t] * cos(angle);
            sum_i += (double)in_real[t] * sin(angle);
        }
        out_real[k] = (float)sum_r;
        out_imag[k] = (float)sum_i;
    }
}
</file>

