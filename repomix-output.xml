 * 3. SIMD RMS VAD computation & confidence scoring
 * 
 * @param packet Pointer to AudioFramePacket.
 */
void dsp_process_frame(AudioFramePacket* packet);

/**
 * @brief Cleans up DSP allocated lookup tables and resources.
 */
