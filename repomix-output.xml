/**
 * High-performance 60 FPS HTML5 Canvas Spectrogram and Waterfall Renderer.
 */

export class SpectrogramVisualizer {
  private canvas: HTMLCanvasElement;
  private ctx: CanvasRenderingContext2D;
  private history: Float32Array[] = [];
  private maxHistory = 150;
  private colorMap = 'plasma';

  constructor(canvas: HTMLCanvasElement) {
    this.canvas = canvas;
    const context = canvas.getContext('2d', { alpha: false });
    if (!context) throw new Error('Could not get 2D canvas context');
    this.ctx = context;
    this.resize();
    window.addEventListener('resize', () => this.resize());
  }

  resize() {
    const rect = this.canvas.getBoundingClientRect();
    this.canvas.width = rect.width * window.devicePixelRatio;
    this.canvas.height = rect.height * window.devicePixelRatio;
  }

  setColorMap(name: string) {
    this.colorMap = name;
  }

  pushSpectrogram(bins: number[]) {
    this.history.push(new Float32Array(bins));
    if (this.history.length > this.maxHistory) {
      this.history.shift();
    }
  }

  render() {
    const w = this.canvas.width;
    const h = this.canvas.height;
    this.ctx.fillStyle = '#0a0c10';
    this.ctx.fillRect(0, 0, w, h);

    if (this.history.length === 0) return;

    const columnWidth = w / this.maxHistory;
    const numBins = this.history[0].length;
    const rowHeight = (h * 0.75) / numBins;

    // 1. Draw Waterfall Spectrogram (Top 75%)
    for (let col = 0; col < this.history.length; col++) {
      const frame = this.history[col];
      const x = col * columnWidth;

      for (let bin = 0; bin < numBins; bin++) {
        const val = Math.min(1.0, Math.max(0.0, frame[bin] * 4.0));
        const y = h * 0.75 - (bin + 1) * rowHeight;

        this.ctx.fillStyle = this.getColormapColor(val);
        this.ctx.fillRect(x, y, columnWidth + 1, rowHeight + 1);
      }
    }

    // 2. Draw Live FFT Bar Graph (Bottom 25%)
    const latest = this.history[this.history.length - 1];
    const barWidth = w / numBins;
    const bottomH = h * 0.25;

    this.ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
    this.ctx.fillRect(0, h * 0.75, w, bottomH);

    for (let bin = 0; bin < numBins; bin++) {
      const val = Math.min(1.0, latest[bin] * 5.0);
      const barH = val * (bottomH - 10);
      const x = bin * barWidth;
      const y = h - barH;

      this.ctx.fillStyle = this.getColormapColor(val);
      this.ctx.fillRect(x, y, barWidth - 1, barH);
    }
  }

  private getColormapColor(v: number): string {
    if (this.colorMap === 'viridis') {
      const r = Math.floor(v * 68 + (1 - v) * 34);
      const g = Math.floor(v * 200 + (1 - v) * 50);
      const b = Math.floor(v * 110 + (1 - v) * 90);
      return `rgb(${r},${g},${b})`;
    } else if (this.colorMap === 'fire') {
      const r = Math.floor(Math.min(255, v * 350));
      const g = Math.floor(Math.min(255, Math.max(0, (v - 0.3) * 300)));
      const b = Math.floor(Math.min(255, Math.max(0, (v - 0.7) * 400)));
      return `rgb(${r},${g},${b})`;
    } else {
      // Plasma (default)
      const r = Math.floor(Math.sin(v * Math.PI * 0.8) * 200 + 30);
      const g = Math.floor(Math.pow(v, 2.0) * 180);
      const b = Math.floor(Math.cos(v * Math.PI * 0.5) * 220 + 35);
      return `rgb(${r},${g},${b})`;
    }
  }
}
