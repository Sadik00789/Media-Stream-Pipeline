use numpy::PyArray1;
use pyo3::prelude::*;

/// Creates a zero-copy NumPy 1D array view from a raw slice of float32 PCM samples.
/// 
/// # Safety
/// The underlying memory must remain valid for the duration of Python processing.
pub unsafe fn slice_to_pyarray<'py>(
    py: Python<'py>,
    slice: &[f32],
) -> Bound<'py, PyArray1<f32>> {
    PyArray1::from_slice_bound(py, slice)
}

/// Creates a zero-copy NumPy 1D array view directly from a raw pointer and length.
/// 
/// # Safety
/// Caller guarantees ptr is non-null, aligned, and valid for `len` elements.
pub unsafe fn raw_ptr_to_pyarray<'py>(
    py: Python<'py>,
    ptr: *const f32,
    len: usize,
) -> Bound<'py, PyArray1<f32>> {
    let slice = std::slice::from_raw_parts(ptr, len);
    PyArray1::from_slice_bound(py, slice)
}
