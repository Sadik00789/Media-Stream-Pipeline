<file path="include/ipc_protocol.h">
/**
 * @file ipc_protocol.h
 * @brief Cross-language binary protocol for ultra-low latency shared memory IPC.
 * 
 * Synchronized across C, Go, and Rust.
 * All structs use strict byte-level packing (#pragma pack(push, 1)).
 */

#ifndef IPC_PROTOCOL_H
#define IPC_PROTOCOL_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

#define FRAME_SAMPLES 512
#define SPECTROGRAM_BINS 256
#define SHM_RING_CAPACITY 64
#define SHM_NAME "/media_stream_ring"
#define SHM_MAGIC 0x4D535452 /* 'MSTR' */
#define SHM_VERSION 1

/* Packet processing flags */
#define FLAG_INGESTED   (1 << 0)  /* Written by WebRTC Gateway */
#define FLAG_DSP_DONE   (1 << 1)  /* DSP (FFT/VAD) processed */
#define FLAG_ML_DONE    (1 << 2)  /* ML inference processed */
#define FLAG_BROADCAST  (1 << 3)  /* Telemetry transmitted to client */

#pragma pack(push, 1)

/**
 * @struct AudioFramePacket
 * @brief Represents a single 512-sample audio frame with associated DSP & ML metadata.
 */
typedef struct {
    uint64_t sequence_number;       /* Monotonically increasing frame index */
    uint64_t timestamp_ns;          /* Ingestion timestamp in nanoseconds */
    uint32_t sample_rate;           /* Audio sample rate (typically 16000 Hz) */
    uint32_t channels;              /* Audio channel count (1 for mono) */
    uint32_t sample_count;          /* Number of samples in frame (512) */
    float pcm_data[FRAME_SAMPLES];  /* Raw float32 PCM samples normalized [-1.0, 1.0] */
    float spectrogram[SPECTROGRAM_BINS]; /* 256-bin FFT power/magnitude spectrum */
    uint8_t vad_active;             /* 1 if speech detected, 0 otherwise */
    float vad_confidence;           /* VAD energy/confidence score [0.0, 1.0] */
    float ml_confidence;            /* ML model confidence score [0.0, 1.0] */
    char ml_transcript[128];        /* Streaming ASR transcript / token buffer */
    uint8_t flags;                  /* Processing state flags */
    uint8_t reserved[3];            /* Padding for alignment */
} AudioFramePacket;

/**
 * @struct SharedMemoryRingBuffer
 * @brief Lock-free SPSC / MPMC ring buffer layout in POSIX shared memory (/dev/shm).
 */
typedef struct {
    uint32_t magic;                 /* Validation magic number (SHM_MAGIC) */
    uint32_t version;               /* Protocol schema version */
    uint32_t buffer_capacity;       /* Maximum frame slots in ring buffer (64) */
    uint32_t packet_size;           /* Byte size of AudioFramePacket */
    uint64_t write_head;            /* Monotonically increasing write cursor */
    uint64_t read_head;             /* Monotonically increasing read cursor */
    AudioFramePacket packets[SHM_RING_CAPACITY]; /* Contiguous packet slots */
} SharedMemoryRingBuffer;

#pragma pack(pop)

#ifdef __cplusplus
}
#endif

#endif /* IPC_PROTOCOL_H */
</file>

