<file path="dsp/src/simd_vad.c">
/**
 * @file simd_vad.c
 * @brief Vectorized RMS energy computation and Voice Activity Detection (VAD).
 */

#include "simd_vad.h"
#include <math.h>

#if defined(__AVX2__)
#include <immintrin.h>

static inline float hsum256_ps(__m256 v) {
    __m128 vlow = _mm256_castps256_ps128(v);
    __m128 vhigh = _mm256_extractf128_ps(v, 1);
    __m128 vsum = _mm_add_ps(vlow, vhigh);
    vsum = _mm_add_ps(vsum, _mm_movehl_ps(vsum, vsum));
    vsum = _mm_add_ss(vsum, _mm_shuffle_ps(vsum, vsum, 1));
    return _mm_cvtss_f32(vsum);
}

float dsp_compute_rms_energy_avx2(const float* audio, size_t n) {
    if (!audio || n == 0) return 0.0f;

    size_t i = 0;
    size_t vec_len = n - (n % 8);
    __m256 sum_vec = _mm256_setzero_ps();

    for (; i < vec_len; i += 8) {
        __m256 s = _mm256_loadu_ps(&audio[i]);
#if defined(__FMA__)
        sum_vec = _mm256_fmadd_ps(s, s, sum_vec);
#else
        __m256 s2 = _mm256_mul_ps(s, s);
        sum_vec = _mm256_add_ps(sum_vec, s2);
#endif
    }

    float total_sq = hsum256_ps(sum_vec);

    for (; i < n; i++) {
        total_sq += audio[i] * audio[i];
    }

    return sqrtf(total_sq / (float)n);
}
#endif

float dsp_compute_rms_energy(const float* audio, size_t n) {
    if (!audio || n == 0) return 0.0f;

#if defined(__AVX2__)
    return dsp_compute_rms_energy_avx2(audio, n);
#else
    float total_sq = 0.0f;
    for (size_t i = 0; i < n; i++) {
        total_sq += audio[i] * audio[i];
    }
    return sqrtf(total_sq / (float)n);
#endif
}

uint8_t dsp_vad_decision(float energy, float threshold, float* out_confidence) {
    uint8_t active = (energy >= threshold) ? 1 : 0;
    if (out_confidence) {
        /* Scale confidence score dynamically relative to threshold */
        if (threshold > 0.0f) {
            float ratio = energy / threshold;
            float conf = 1.0f / (1.0f + expf(-4.0f * (ratio - 1.0f)));
            *out_confidence = conf > 1.0f ? 1.0f : (conf < 0.0f ? 0.0f : conf);
        } else {
            *out_confidence = active ? 1.0f : 0.0f;
        }
    }
    return active;
}
</file>

<file path="dsp/src/windowing.c">
/**
 * @file windowing.c
 * @brief SIMD audio windowing implementation with AVX2 and scalar fallbacks.
 */

#include "windowing.h"
#include <math.h>

#if defined(__AVX2__)
#include <immintrin.h>
#endif

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

void dsp_init_window_table(float* window_table, size_t n, DspWindowType type) {
    if (!window_table || n == 0) return;

    for (size_t i = 0; i < n; i++) {
        switch (type) {
            case DSP_WINDOW_HAMMING:
                window_table[i] = 0.54f - 0.46f * cosf((2.0f * (float)M_PI * (float)i) / (float)(n - 1));
                break;
            case DSP_WINDOW_HANNING:
                window_table[i] = 0.50f * (1.0f - cosf((2.0f * (float)M_PI * (float)i) / (float)(n - 1)));
                break;
            case DSP_WINDOW_BLACKMAN:
                window_table[i] = 0.42f - 0.50f * cosf((2.0f * (float)M_PI * (float)i) / (float)(n - 1))
                                       + 0.08f * cosf((4.0f * (float)M_PI * (float)i) / (float)(n - 1));
                break;
            case DSP_WINDOW_RECTANGULAR:
            default:
                window_table[i] = 1.0f;
                break;
        }
    }
}

void dsp_apply_window_avx2(const float* input, const float* window, float* output, size_t n) {
#if defined(__AVX2__)
    size_t i = 0;
    size_t vec_len = n - (n % 8);

    for (; i < vec_len; i += 8) {
        __m256 in_vec = _mm256_loadu_ps(&input[i]);
        __m256 win_vec = _mm256_loadu_ps(&window[i]);
        __m256 res_vec = _mm256_mul_ps(in_vec, win_vec);
        _mm256_storeu_ps(&output[i], res_vec);
    }

    for (; i < n; i++) {
        output[i] = input[i] * window[i];
    }
#else
    for (size_t i = 0; i < n; i++) {
        output[i] = input[i] * window[i];
    }
#endif
}

void dsp_apply_window(const float* input, const float* window, float* output, size_t n) {
#if defined(__AVX2__)
    dsp_apply_window_avx2(input, window, output, n);
#else
    for (size_t i = 0; i < n; i++) {
        output[i] = input[i] * window[i];
    }
#endif
}
</file>

<file path="dsp/tests/test_fft.c">
/**
 * @file test_fft.c
 * @brief Unit tests validating SIMD FFT accuracy against naive DFT and frequency bin correctness.
 */

#include "dsp_core.h"
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <assert.h>
#include <time.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

int main(void) {
    printf("[TEST] Running SIMD FFT verification suite...\n");

    dsp_init();

    float test_signal[FRAME_SAMPLES];
    float fft_real[FRAME_SAMPLES];
    float fft_imag[FRAME_SAMPLES];
    float dft_real[FRAME_SAMPLES];
    float dft_imag[FRAME_SAMPLES];
    float magnitude[SPECTROGRAM_BINS];

    /* Generate a 1000 Hz pure sine wave at 16000 Hz sample rate */
    const float sample_rate = 16000.0f;
    const float target_freq = 1000.0f;
    for (int i = 0; i < FRAME_SAMPLES; i++) {
        test_signal[i] = sinf(2.0f * (float)M_PI * target_freq * (float)i / sample_rate);
    }

    /* Execute Forward FFT */
    dsp_fft_forward_512(test_signal, fft_real, fft_imag);
    dsp_fft_magnitude_256(fft_real, fft_imag, magnitude);

    /* Execute Reference Naive DFT */
    dsp_dft_naive(test_signal, dft_real, dft_imag, FRAME_SAMPLES);

    /* Verify FFT vs DFT numerical precision */
    float max_error = 0.0f;
    for (int i = 0; i < FRAME_SAMPLES; i++) {
        float err_r = fabsf(fft_real[i] - dft_real[i]);
        float err_i = fabsf(fft_imag[i] - dft_imag[i]);
        if (err_r > max_error) max_error = err_r;
        if (err_i > max_error) max_error = err_i;
    }

    printf("  -> Max numerical error (FFT vs Naive DFT): %e\n", (double)max_error);
    assert(max_error < 1e-3f && "FFT output diverges from naive DFT reference!");

    /* Verify peak frequency bin (1000 Hz * 512 / 16000 = bin 32) */
    int expected_bin = (int)roundf(target_freq * (float)FRAME_SAMPLES / sample_rate);
    int peak_bin = 0;
    float peak_val = 0.0f;
    for (int i = 0; i < SPECTROGRAM_BINS; i++) {
        if (magnitude[i] > peak_val) {
            peak_val = magnitude[i];
            peak_bin = i;
        }
    }

    printf("  -> Expected Peak Bin: %d, Detected Peak Bin: %d (Mag: %.4f)\n", expected_bin, peak_bin, (double)peak_val);
    assert(peak_bin == expected_bin && "Spectral peak does not match expected frequency bin!");

    /* Benchmark FFT performance */
    const int iterations = 10000;
    clock_t start = clock();
    for (int iter = 0; iter < iterations; iter++) {
        dsp_fft_forward_512(test_signal, fft_real, fft_imag);
        dsp_fft_magnitude_256(fft_real, fft_imag, magnitude);
    }
    clock_t end = clock();
    double total_ms = ((double)(end - start) / CLOCKS_PER_SEC) * 1000.0;
    double us_per_frame = (total_ms / iterations) * 1000.0;

    printf("  -> Benchmark: %.2f µs per 512-pt FFT+Mag (%d iterations)\n", us_per_frame, iterations);

    dsp_destroy();
    printf("[PASS] FFT verification test passed successfully!\n");
    return 0;
}
