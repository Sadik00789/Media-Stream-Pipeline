# Multi-stage C/Rust/Python ML Worker Runtime
FROM rust:1.79-bookworm AS builder

RUN apt-get update && apt-get install -y \
    cmake \
    clang \
    llvm \
    libclang-dev \
    python3 \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# 1. Build C DSP Static Library
RUN cd dsp && cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build

# 2. Build Rust ml-worker
RUN cargo build --manifest-path crates/Cargo.toml --release --bin ml-worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/crates/target/release/ml-worker /app/ml-worker
COPY --from=builder /app/dsp/build/libdsp_core.a /app/libdsp_core.a
COPY python/src /app/python/src
COPY python/models /app/python/models

ENV PYTHONPATH="/app/python/src"
CMD ["/app/ml-worker"]
